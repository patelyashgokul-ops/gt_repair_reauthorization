<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_form_repair_authorization" model="ir.ui.view">
        <field name="name">sale.order.form.repair.authorization</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_repair_authorizations" type="object"
                        class="oe_stat_button" icon="fa-shield"
                        groups="gt_repair_reauthorization.group_repair_authorization_technician"
                        invisible="not repair_authorization_count">
                    <field name="repair_authorization_count" widget="statinfo" string="Repair Authorizations"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
